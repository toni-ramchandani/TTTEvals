# Copy this file to .env, then pick ONE of the setups below.
# Every command reads it. Command-line options override it for one run:
#   python run.py day1 --model openai/gpt-5.4-mini --embed openai/text-embedding-3-small
# Model names are "provider/model": ollama/, openai/, gemini/ or anthropic/.
# If a setting appears twice in .env, the FIRST one wins, so comment out the
# Ollama lines when you switch to a cloud setup.

# ---------------------------------------------------------------------------
# A. Ollama on your own laptop (the default; free, private, no API key)
# ---------------------------------------------------------------------------
# 1. Install Ollama from https://ollama.com and start it.
# 2. Pull the two models once:
#      ollama pull llama3.1:8b
#      ollama pull nomic-embed-text
# 3. python run.py check
HELIX_GENERATION_MODEL=ollama/llama3.1:8b
HELIX_EMBEDDING_MODEL=ollama/nomic-embed-text
# Better tool calling for the agent on Day 3, if your laptop has the memory:
# HELIX_GENERATION_MODEL=ollama/qwen3:8b
# Ollama on another machine or port:
# OLLAMA_API_BASE=http://localhost:11434
# Context window for chat calls; the agent's conversation needs more than
# Ollama's default, and Ollama truncates silently when it overflows:
# OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------------------
# B. OpenAI
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# HELIX_GENERATION_MODEL=openai/gpt-5.4-mini
# HELIX_EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------------------------------------------------------------------------
# C. Anthropic (no embedding API: keep Ollama embeddings, or use OpenAI's)
# ---------------------------------------------------------------------------
# Called through Anthropic's OpenAI-compatible endpoint, which Anthropic
# describes as meant for testing and comparing models; fine for a workshop.
# ANTHROPIC_API_KEY=sk-ant-...
# HELIX_GENERATION_MODEL=anthropic/claude-haiku-5-5
# HELIX_EMBEDDING_MODEL=ollama/nomic-embed-text

# ---------------------------------------------------------------------------
# D. Google Gemini
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=...
# HELIX_GENERATION_MODEL=gemini/gemini-3.6-flash
# HELIX_EMBEDDING_MODEL=gemini/gemini-embedding-001

# ---------------------------------------------------------------------------
# The judge for Day 2's evaluators, Day 3's judges and both toolkits. Empty =
# the answer model judges itself. A stronger, different model is the better
# practice, and toolkit judges need one that writes valid JSON reliably:
# HELIX_JUDGE_MODEL=anthropic/claude-sonnet-5-5
HELIX_JUDGE_MODEL=

# Local and cloud together: each role can use a different provider in the
# same run, for example answers on Ollama and the judge on an API:
#   HELIX_GENERATION_MODEL=ollama/llama3.1:8b
#   HELIX_EMBEDDING_MODEL=ollama/nomic-embed-text
#   HELIX_JUDGE_MODEL=openai/gpt-5.4-mini        (and OPENAI_API_KEY above)
# Every call is live. Nothing is cached or stored between commands.

# Toolkit environment only (DeepEval and Ragas, Days 2 to 4). Telemetry,
# uploads and DeepEval's disk writes are switched off by the code before
# either toolkit loads; these are here so you can see them. Never put a
# CONFIDENT_API_KEY in this file: the workshop removes it.
# DEEPEVAL_TELEMETRY_OPT_OUT=1
# DEEPEVAL_FILE_SYSTEM=READ_ONLY
# RAGAS_DO_NOT_TRACK=true
# Day 4 CI gate: the faithfulness floor from your charter.
# HELIX_GATE_FAITHFULNESS=0.8

# GraphRAG fact extraction: "rules" (same graph on every laptop) or "llm"
# (your model reads the handbook and writes the facts; compare the two).
HELIX_GRAPH_EXTRACTOR=rules

# Pin model versions. An unpinned model string makes today's traces
# incomparable with yesterday's (Day 4).

# The reference run: a deterministic stub, no model at all. It reproduces the
# exact numbers on the slides. Prefer `--offline` on one command over this.
# HELIX_OFFLINE=1
